<UserControl x:Class="Fluxio.Desktop.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fluxio.Desktop.Controls"
             xmlns:l="clr-namespace:Fluxio.Desktop.Services">
    <!-- DataContext: HomeViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="40,34,40,34" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Fluxio;component/Resources/fluxio-256.png" Width="60" Height="60" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Fluxio" Style="{StaticResource Text.Display}" />
                    <TextBlock Text="{l:Tr Home.Slogan}" Style="{StaticResource Text.Muted}" FontSize="16" />
                </StackPanel>
                <Border Grid.Column="2" DataContext="{Binding Session}" Style="{StaticResource SessionPill}" VerticalAlignment="Center" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Two main actions -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Button.ActionCard}" c:Ui.Accent="{DynamicResource Brush.Accent}" Command="{Binding GoCommand}" CommandParameter="Send"
                        AutomationProperties.Name="{l:Tr Home.SendTitle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="68" Height="68" CornerRadius="20" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
                            <c:Icon Data="{StaticResource Icon.Upload}" Size="32" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,2,8,0">
                            <TextBlock Text="{l:Tr Home.SendTitle}" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{l:Tr Home.SendBody}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
                        </StackPanel>
                        <c:Icon Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Size="22" Foreground="{DynamicResource Brush.TextSubtle}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource Button.ActionCard}" c:Ui.Accent="{DynamicResource Brush.Receive}" Command="{Binding GoCommand}" CommandParameter="Receive"
                        AutomationProperties.Name="{l:Tr Home.ReceiveTitle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="68" Height="68" CornerRadius="20" Background="{DynamicResource Brush.ReceiveSoft}" VerticalAlignment="Top">
                            <c:Icon Data="{StaticResource Icon.Download}" Size="32" Foreground="{DynamicResource Brush.Receive}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,2,8,0">
                            <TextBlock Text="{l:Tr Home.ReceiveTitle}" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{l:Tr Home.ReceiveBody}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
                        </StackPanel>
                        <c:Icon Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Size="22" Foreground="{DynamicResource Brush.TextSubtle}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Activity / recent / quick settings -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Tr Home.Recent}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Content="{l:Tr Home.ViewHistory}" Command="{Binding GoCommand}" CommandParameter="History" />
                        </Grid>
                        <Border Style="{StaticResource Notice.Info}" Margin="0,0,0,14" Visibility="{Binding ActiveTransfers, Converter={StaticResource VisibleIfSet}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ActiveText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Style="{StaticResource Button.Link}" Content="{l:Tr Home.ViewTransfers}" Command="{Binding GoCommand}" CommandParameter="Transfers" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{l:Tr Home.NoRecent}" Style="{StaticResource Text.Muted}" Margin="0,8" Visibility="{Binding HasRecent, Converter={StaticResource Hidden}}" />
                        <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Incoming}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.ReceiveSoft}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <c:Icon Size="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <c:Icon.Style>
                                                    <Style TargetType="c:Icon" BasedOn="{StaticResource {x:Type c:Icon}}">
                                                        <Setter Property="Data" Value="{StaticResource Icon.Upload}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Incoming}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource Icon.Download}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Receive}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </c:Icon.Style>
                                            </c:Icon>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Outcome}" Style="{StaticResource ToneText}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Home.QuickSettings}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16" />
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsDark}" Margin="0,0,0,14">
                            <TextBlock Text="{l:Tr Home.DarkTheme}" />
                        </CheckBox>
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsEnglish}" Margin="0,0,0,14">
                            <TextBlock Text="{l:Tr Home.English}" />
                        </CheckBox>
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RequireApproval}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr Settings.IncomingApproval}" />
                                <TextBlock Text="{l:Tr Home.ApprovalHint}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </CheckBox>
                        <Button Style="{StaticResource Button.Ghost}" c:Ui.Icon="{StaticResource Icon.Settings}" Content="{l:Tr Home.AllSettings}" Command="{Binding GoCommand}" CommandParameter="Settings"
                                HorizontalAlignment="Left" Margin="-8,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
