<UserControl x:Class="Fluxio.Desktop.Views.Pages.SendPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fluxio.Desktop.Controls"
             xmlns:l="clr-namespace:Fluxio.Desktop.Services"
             xmlns:ctl="clr-namespace:Fluxio.Desktop.Views.Controls">
    <!-- DataContext: SendViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="40,30,40,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,24">
                <TextBlock Text="{l:Tr Send.Title}" Style="{StaticResource Text.Display}" />
                <TextBlock Text="{l:Tr Send.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="15" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Files -->
            <StackPanel Grid.Row="1">
                <Border x:Name="dropZone" AllowDrop="True" CornerRadius="16" BorderThickness="2" Padding="24" Margin="0,0,0,16"
                        DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
                        AutomationProperties.Name="{l:Tr Send.DropTitle}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                            <c:Icon Data="{StaticResource Icon.Upload}" Size="26" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{l:Tr Send.DropTitle}" Style="{StaticResource Text.Subtitle}" TextAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="{l:Tr Send.DropHint}" Style="{StaticResource Text.Muted}" FontSize="13" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Style="{StaticResource Button.Secondary}" c:Ui.Icon="{StaticResource Icon.File}" Content="{l:Tr Send.AddFiles}" Command="{Binding AddFilesCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button.Secondary}" c:Ui.Icon="{StaticResource Icon.Folder}" Content="{l:Tr Send.AddFolder}" Command="{Binding AddFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Notice.Error}" Margin="0,0,0,16">
                    <Border.Visibility>
                        <MultiBinding Converter="{x:Static c:MessageVisibility.Error}">
                            <Binding Path="Message" />
                            <Binding Path="MessageIsError" />
                        </MultiBinding>
                    </Border.Visibility>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
                </Border>
                <Border Style="{StaticResource Notice.Success}" Margin="0,0,0,16">
                    <Border.Visibility>
                        <MultiBinding Converter="{x:Static c:MessageVisibility.Success}">
                            <Binding Path="Message" />
                            <Binding Path="MessageIsError" />
                        </MultiBinding>
                    </Border.Visibility>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Link}" Content="{l:Tr Send.ViewTransfers}" Command="{Binding ViewTransfersCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="8">
                    <StackPanel>
                        <Grid Margin="12,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TotalText}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" c:Ui.Icon="{StaticResource Icon.Trash}" Content="{l:Tr Send.ClearAll}" Command="{Binding ClearCommand}"
                                    Visibility="{Binding HasFiles, Converter={StaticResource Visible}}" />
                        </Grid>

                        <!-- Empty state -->
                        <StackPanel Margin="0,26,0,30" Visibility="{Binding HasFiles, Converter={StaticResource Hidden}}">
                            <c:Icon Data="{StaticResource Icon.File}" Size="34" Foreground="{DynamicResource Brush.TextSubtle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{l:Tr Send.Empty}" Style="{StaticResource Text.Muted}" TextAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Files}" Focusable="False" MaxHeight="420">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="row" CornerRadius="10" Padding="12,9" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Brush.Surface2}">
                                                <c:Icon Data="{StaticResource Icon.File}" Size="18" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Text.Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Grid.Column="3" Style="{StaticResource Button.Icon}" c:Ui.Icon="{StaticResource Icon.Close}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    ToolTip="{l:Tr Common.Remove}" AutomationProperties.Name="{l:Tr Common.Remove}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Connection + start -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <ctl:QrPanel DataContext="{Binding Session}" />
                <Button Style="{StaticResource Button.Primary}" c:Ui.Icon="{StaticResource Icon.Upload}" Content="{l:Tr Send.Start}" Command="{Binding SendCommand}"
                        Margin="0,16,0,0" Padding="18,13" FontSize="15" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding SendHint}" Style="{StaticResource Text.Caption}" TextAlignment="Center" Margin="0,8,0,0"
                           Visibility="{Binding SendHint, Converter={StaticResource VisibleIfSet}}" />
                <Button Style="{StaticResource Button.Ghost}" c:Ui.Icon="{StaticResource Icon.Close}" Content="{l:Tr Session.Cancel}" Command="{Binding Session.EndCommand}"
                        HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="{Binding Session.IsOpen, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
