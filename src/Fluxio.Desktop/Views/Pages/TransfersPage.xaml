<UserControl x:Class="Fluxio.Desktop.Views.Pages.TransfersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fluxio.Desktop.Controls"
             xmlns:l="clr-namespace:Fluxio.Desktop.Services">
    <!-- DataContext: TransfersViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,30,40,34" MaxWidth="1100">
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Tr Transfers.Title}" Style="{StaticResource Text.Display}" />
                    <TextBlock Text="{l:Tr Transfers.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="15" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" c:Ui.Icon="{StaticResource Icon.Trash}" Content="{l:Tr Transfers.ClearFinished}"
                        Command="{Binding ClearFinishedCommand}" VerticalAlignment="Bottom" />
            </Grid>

            <!-- Overall -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsEmpty, Converter={StaticResource Hidden}}">
                <StackPanel>
                    <TextBlock Text="{Binding OverallText}" Style="{StaticResource Text.Subtitle}" />
                    <ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" Maximum="100" Height="10" Margin="0,12,0,0"
                                 Visibility="{Binding ActiveCount, Converter={StaticResource VisibleIfSet}}" />
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Padding="40" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource Brush.Surface2}" HorizontalAlignment="Center">
                        <c:Icon Data="{StaticResource Icon.Transfers}" Size="30" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{l:Tr Transfers.Empty}" Style="{StaticResource Text.Subtitle}" TextAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="{l:Tr Transfers.EmptyHint}" Style="{StaticResource Text.Muted}" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Batches}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIncoming}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.ReceiveSoft}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <c:Icon Size="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <c:Icon.Style>
                                                <Style TargetType="c:Icon" BasedOn="{StaticResource {x:Type c:Icon}}">
                                                    <Setter Property="Data" Value="{StaticResource Icon.Upload}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIncoming}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource Icon.Download}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Receive}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </c:Icon.Style>
                                        </c:Icon>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" />
                                        <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Started, Mode=OneWay}" /> · <Run Text="{Binding StatusText, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Button.Danger}" c:Ui.Icon="{StaticResource Icon.Close}" Content="{l:Tr Transfers.CancelAll}"
                                            Command="{Binding CancelCommand}" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource Visible}}" />
                                </Grid>

                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="10" Margin="0,16,0,0" Style="{StaticResource ToneProgress}" />
                                <Grid Margin="0,8,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="15" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Text.Muted}" FontSize="13" VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Files}" Focusable="False" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Inset}" Margin="0,0,0,8" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,6">
                                                            <Run Text="{Binding Detail, Mode=OneWay}" /> · <Run Text="{Binding Kind, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" Style="{StaticResource ToneProgress}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource ToneText}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource Button.Ghost}" Content="{l:Tr Common.ShowInFolder}" Command="{Binding ShowCommand}"
                                                                Visibility="{Binding CanShow, Converter={StaticResource Visible}}" />
                                                        <Button Style="{StaticResource Button.Icon}" c:Ui.Icon="{StaticResource Icon.Close}" Command="{Binding CancelCommand}"
                                                                ToolTip="{l:Tr Transfers.CancelFile}" AutomationProperties.Name="{l:Tr Transfers.CancelFile}"
                                                                Visibility="{Binding CanCancel, Converter={StaticResource Visible}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{l:Tr Transfers.CancelNote}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
