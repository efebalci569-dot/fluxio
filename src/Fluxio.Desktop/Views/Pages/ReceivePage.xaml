<UserControl x:Class="Fluxio.Desktop.Views.Pages.ReceivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fluxio.Desktop.Controls"
             xmlns:l="clr-namespace:Fluxio.Desktop.Services"
             xmlns:pages="clr-namespace:Fluxio.Desktop.Views.Pages"
             xmlns:ctl="clr-namespace:Fluxio.Desktop.Views.Controls">
    <!-- DataContext: ReceiveViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="40,30,40,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,24">
                <TextBlock Text="{l:Tr Receive.Title}" Style="{StaticResource Text.Display}" />
                <TextBlock Text="{l:Tr Receive.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="15" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <ctl:QrPanel DataContext="{Binding Session}" />
                <Button Style="{StaticResource Button.Ghost}" c:Ui.Icon="{StaticResource Icon.Close}" Content="{l:Tr Session.Close}" Command="{Binding Session.EndCommand}"
                        HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="{Binding Session.IsOpen, Converter={StaticResource Visible}}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2">
                <!-- Download folder -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Brush.Surface2}">
                                <c:Icon Data="{StaticResource Icon.Folder}" Size="22" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:Tr Receive.Folder}" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="{Binding DownloadFolder}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DownloadFolder}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Ghost}" Content="{l:Tr Common.Open}" Command="{Binding OpenFolderCommand}" Margin="0,0,4,0" />
                                <Button Style="{StaticResource Button.Secondary}" Content="{l:Tr Common.Change}" Command="{Binding ChangeFolderCommand}" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Notice.Error}" Margin="0,12,0,0" Visibility="{Binding FolderError, Converter={StaticResource VisibleIfSet}}">
                            <TextBlock Text="{Binding FolderError}" Style="{StaticResource Text.Body}" FontSize="13" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Incoming requests -->
                <ItemsControl ItemsSource="{Binding Requests}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <pages:IncomingRequestCard Margin="0,0,0,16" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Waiting / received -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Receive.Received}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,12" />
                        <StackPanel Margin="0,10,0,14" Visibility="{Binding Received.Count, Converter={StaticResource VisibleIfEmpty}}">
                            <c:Icon Data="{StaticResource Icon.Phone}" Size="32" Foreground="{DynamicResource Brush.TextSubtle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{l:Tr Receive.Waiting}" Style="{StaticResource Text.Muted}" TextAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Received}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Brush.SuccessSoft}">
                                            <c:Icon Data="{StaticResource Icon.Check}" Size="18" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding Detail, Mode=OneWay}" /> · <Run Text="{Binding StatusText, Mode=OneWay}" /></TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Content="{l:Tr Common.ShowInFolder}" Command="{Binding ShowCommand}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
