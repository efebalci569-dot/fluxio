<UserControl x:Class="Fluxio.Desktop.Views.Pages.IncomingRequestCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fluxio.Desktop.Controls"
             xmlns:l="clr-namespace:Fluxio.Desktop.Services">
    <!-- DataContext: IncomingRequestViewModel. Used inline on the Receive page and as an overlay elsewhere. -->
    <Border Style="{StaticResource Card}" Padding="24" BorderBrush="{DynamicResource Brush.Receive}" AutomationProperties.Name="{Binding Title}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource Brush.ReceiveSoft}">
                    <c:Icon Data="{StaticResource Icon.Download}" Size="26" Foreground="{DynamicResource Brush.Receive}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="18" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" FontSize="13" />
                </StackPanel>
            </Grid>

            <StackPanel DockPanel.Dock="Bottom">
                <!-- Target folder -->
                <Border Style="{StaticResource Inset}" Margin="0,14,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:Icon Data="{StaticResource Icon.Folder}" Size="18" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock Text="{l:Tr Incoming.SaveTo}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding TargetFolder}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetFolder}" />
                            <TextBlock Text="{Binding FreeSpaceText}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Content="{l:Tr Common.Change}" Command="{Binding ChangeFolderCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Name conflicts -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasConflicts, Converter={StaticResource Visible}}">
                    <Border Style="{StaticResource Notice.Warning}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ConflictText}" Style="{StaticResource Text.Body}" FontSize="13" />
                    </Border>
                    <RadioButton Style="{StaticResource OptionRadio}" GroupName="{Binding Batch.Id}"
                                 IsChecked="{Binding Policy, Converter={StaticResource EqualsToBool}, ConverterParameter=Rename}">
                        <TextBlock><Run Text="{l:Tr Conflict.Rename}" FontWeight="SemiBold" /> <Run Text="{l:Tr Conflict.RenameHint}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource OptionRadio}" GroupName="{Binding Batch.Id}"
                                 IsChecked="{Binding Policy, Converter={StaticResource EqualsToBool}, ConverterParameter=Overwrite}">
                        <TextBlock><Run Text="{l:Tr Conflict.Overwrite}" FontWeight="SemiBold" /> <Run Text="{l:Tr Conflict.OverwriteHint}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource OptionRadio}" GroupName="{Binding Batch.Id}"
                                 IsChecked="{Binding Policy, Converter={StaticResource EqualsToBool}, ConverterParameter=Skip}">
                        <TextBlock><Run Text="{l:Tr Conflict.Skip}" FontWeight="SemiBold" /> <Run Text="{l:Tr Conflict.SkipHint}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                    </RadioButton>
                </StackPanel>

                <Border Style="{StaticResource Notice.Error}" Margin="0,12,0,0" Visibility="{Binding Error, Converter={StaticResource VisibleIfSet}}">
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Body}" FontSize="13" />
                </Border>

                <TextBlock Text="{l:Tr Incoming.SafetyNote}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Style="{StaticResource Button.Secondary}" c:Ui.Icon="{StaticResource Icon.Close}" Content="{l:Tr Incoming.Decline}" Command="{Binding DeclineCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Primary}" c:Ui.Icon="{StaticResource Icon.Check}" Content="{l:Tr Incoming.Accept}" Command="{Binding AcceptCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Files -->
            <ItemsControl ItemsSource="{Binding Files}" Focusable="False" MaxHeight="220">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:Icon Data="{StaticResource Icon.File}" Size="18" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Text.Muted}" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
