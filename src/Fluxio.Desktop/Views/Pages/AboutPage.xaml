<UserControl x:Class="Fluxio.Desktop.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fluxio.Desktop.Controls"
             xmlns:l="clr-namespace:Fluxio.Desktop.Services">
    <!-- DataContext: AboutViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,30,40,34" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Image Source="/Fluxio;component/Resources/fluxio-256.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Fluxio" Style="{StaticResource Text.Display}" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Your Files. Your Devices. One Connection." Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{l:Tr About.Description}" Style="{StaticResource Text.Muted}" Margin="0,10,0,16" />
                    <WrapPanel>
                        <Button Style="{StaticResource Button.Secondary}" c:Ui.Icon="{StaticResource Icon.Code}" Content="{l:Tr About.Source}" Command="{Binding OpenGitHubCommand}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Button.Ghost}" c:Ui.Icon="{StaticResource Icon.Folder}" Content="{l:Tr About.Logs}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:Tr About.HowItWorks}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,10" />
                    <TextBlock Text="{l:Tr About.HowItWorksText}" Style="{StaticResource Text.Muted}" FontSize="13" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:Tr About.Limitations}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,10" />
                    <TextBlock Text="{l:Tr About.LimitationsText}" Style="{StaticResource Text.Muted}" FontSize="13" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr About.License}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{l:Tr About.LicenseText}" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,0,0,14" />
                    <TextBlock Text="{l:Tr About.ThirdParty}" Style="{StaticResource Text.Overline}" />
                    <ItemsControl ItemsSource="{Binding Notices}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Button.Link}" Content="{Binding Name}" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Url}" />
                                    <TextBlock Grid.Column="1" Text="{Binding License}" Style="{StaticResource Text.Caption}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
