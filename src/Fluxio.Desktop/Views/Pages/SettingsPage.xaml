<UserControl x:Class="Fluxio.Desktop.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fluxio.Desktop.Controls"
             xmlns:l="clr-namespace:Fluxio.Desktop.Services">
    <!-- DataContext: SettingsViewModel -->
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,30,40,34" MaxWidth="860" HorizontalAlignment="Left" Width="860">
            <TextBlock Text="{l:Tr Settings.Title}" Style="{StaticResource Text.Display}" />
            <TextBlock Text="{l:Tr Settings.Subtitle}" Style="{StaticResource Text.Muted}" FontSize="15" Margin="0,6,0,24" />

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:Tr Settings.Appearance}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,18" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr Settings.Language}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Tr Settings.LanguageHint}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="Türkçe" IsChecked="{Binding Language, Converter={StaticResource EqualsToBool}, ConverterParameter=tr}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="lang" Content="English" IsChecked="{Binding Language, Converter={StaticResource EqualsToBool}, ConverterParameter=en}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr Settings.Theme}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="{l:Tr Settings.ThemeSystem}" IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter=System}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="{l:Tr Settings.ThemeDark}" IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter=Dark}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="theme" Content="{l:Tr Settings.ThemeLight}" IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter=Light}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Transfers -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:Tr Settings.Transfers}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,18" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{l:Tr Settings.DownloadFolder}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DownloadFolder}" Style="{StaticResource Text.Muted}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding DownloadFolder}" />
                            <TextBlock Text="{Binding FolderError}" Foreground="{DynamicResource Brush.Danger}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding FolderError, Converter={StaticResource VisibleIfSet}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Ghost}" Content="{l:Tr Common.Open}" Command="{Binding OpenFolderCommand}" Margin="0,0,4,0" />
                            <Button Style="{StaticResource Button.Secondary}" Content="{l:Tr Common.Change}" Command="{Binding ChangeFolderCommand}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr Settings.SessionDuration}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Tr Settings.SessionDurationHint}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding PairingChoices}" SelectedItem="{Binding SelectedPairing}" DisplayMemberPath="Label" VerticalAlignment="Center"
                                  AutomationProperties.Name="{l:Tr Settings.SessionDuration}" />
                    </Grid>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RequireIncomingApproval}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{l:Tr Settings.IncomingApproval}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Tr Settings.IncomingApprovalHint}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding MarkIncomingFiles}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{l:Tr Settings.MarkFiles}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Tr Settings.MarkFilesHint}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Notifications}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr Settings.Notifications}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Tr Settings.NotificationsHint}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Network -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr Settings.Network}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" c:Ui.Icon="{StaticResource Icon.Refresh}" Content="{l:Tr Common.Refresh}" Command="{Binding RefreshNetworkCommand}" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{l:Tr Settings.Interface}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Tr Settings.InterfaceHint}" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="300" ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{l:Tr Settings.Interface}" />
                    </Grid>
                    <Border Style="{StaticResource Inset}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:Tr Settings.Address}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentAddress}" FontFamily="{StaticResource Font.Mono}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="{l:Tr Settings.Profile}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NetworkCategoryText}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="{l:Tr Settings.Firewall}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="{Binding FirewallText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FirewallTone}" Value="success"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding FirewallTone}" Value="warning"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding FirewallTone}" Value="danger"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource Button.Secondary}" c:Ui.Icon="{StaticResource Icon.Shield}" Content="{l:Tr Network.Fix}" Command="{Binding FixFirewallCommand}"
                                        Margin="0,0,8,0" Visibility="{Binding CanFixFirewall, Converter={StaticResource Visible}}" />
                                <Button Style="{StaticResource Button.Secondary}" c:Ui.Icon="{StaticResource Icon.External}" Content="{l:Tr Network.OpenSettings}" Command="{Binding OpenNetworkSettingsCommand}"
                                        Visibility="{Binding IsPublicNetwork, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{l:Tr Settings.NetworkHelp}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Privacy & maintenance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:Tr Settings.Privacy}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,12" />
                    <TextBlock Text="{l:Tr Settings.PrivacyText}" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,0,0,18" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Secondary}" c:Ui.Icon="{StaticResource Icon.History}" Content="{l:Tr Settings.ClearHistory}" Command="{Binding ClearHistoryCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Secondary}" c:Ui.Icon="{StaticResource Icon.Trash}" Content="{l:Tr Settings.ClearTemp}" Command="{Binding ClearTempCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Ghost}" c:Ui.Icon="{StaticResource Icon.Folder}" Content="{l:Tr Settings.OpenData}" Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                    <Border Style="{StaticResource Notice.Info}" Margin="0,14,0,0" Visibility="{Binding MaintenanceMessage, Converter={StaticResource VisibleIfSet}}">
                        <TextBlock Text="{Binding MaintenanceMessage}" Style="{StaticResource Text.Body}" FontSize="13" />
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Caption}">
                <Run Text="Fluxio" /> <Run Text="{Binding Version, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
