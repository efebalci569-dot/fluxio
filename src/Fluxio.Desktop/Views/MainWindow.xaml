<Window x:Class="Fluxio.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Fluxio.Desktop.Controls"
        xmlns:l="clr-namespace:Fluxio.Desktop.Services"
        xmlns:vm="clr-namespace:Fluxio.Desktop.ViewModels"
        xmlns:pages="clr-namespace:Fluxio.Desktop.Views.Pages"
        Title="Fluxio" Icon="/Fluxio;component/Resources/fluxio.ico"
        Width="1200" Height="780" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><pages:HomePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SendViewModel}"><pages:SendPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReceiveViewModel}"><pages:ReceivePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransfersViewModel}"><pages:TransfersPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><pages:HistoryPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><pages:AboutPage /></DataTemplate>

        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="10" />
                                        <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="2" Background="{DynamicResource Brush.Accent}" Visibility="Hidden" />
                                        <Grid Margin="14,10,10,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <c:Icon Data="{Binding Icon}" Size="20" Foreground="{TemplateBinding Foreground}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                            <Border x:Name="badge" Grid.Column="2" CornerRadius="9" MinWidth="20" Height="20" Padding="6,0" Background="{DynamicResource Brush.Accent}">
                                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentContrast}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Badge}" Value="0">
                                            <Setter TargetName="badge" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Image Source="/Fluxio;component/Resources/fluxio-256.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Fluxio" FontFamily="{StaticResource Font.Display}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{l:Tr App.Tagline}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>

                <!-- Connection status at the bottom of the sidebar -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Inset}" Padding="12,10" DataContext="{Binding Session}">
                    <StackPanel>
                        <Border Style="{StaticResource SessionPill}" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding DeviceLabel}" Style="{StaticResource Text.Caption}" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsConnected, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Border>

                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         AutomationProperties.Name="{l:Tr Nav.Label}" KeyboardNavigation.TabNavigation="Once" />
            </DockPanel>
        </Border>

        <!-- ===== Main area ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Session bar (only while a session is open) -->
            <Border DataContext="{Binding Session}" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="28,10" Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SessionPill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                        <Run Text="{Binding DetailText, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding Endpoint}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.TextSubtle}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Style="{StaticResource Button.Secondary}" c:Ui.Icon="{StaticResource Icon.Power}" Content="{l:Tr Session.End}" Command="{Binding EndCommand}" MinHeight="32" Padding="12,5" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>

        <!-- ===== Overlay: approve a phone ===== -->
        <Grid Grid.ColumnSpan="2" DataContext="{Binding Session}" Visibility="{Binding IsAwaitingApproval, Converter={StaticResource Visible}}">
            <Border Background="{DynamicResource Brush.Scrim}" />
            <Border Style="{StaticResource Card}" Width="440" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    AutomationProperties.Name="{l:Tr Approval.Title}">
                <StackPanel>
                    <Border Width="60" Height="60" CornerRadius="18" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Left">
                        <c:Icon Data="{StaticResource Icon.Phone}" Size="28" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{l:Tr Approval.Title}" Style="{StaticResource Text.Title}" Margin="0,18,0,6" />
                    <TextBlock Text="{l:Tr Approval.Body}" Style="{StaticResource Text.Muted}" />
                    <Border Style="{StaticResource Inset}" Margin="0,18,0,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceLabel}" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock Text="{Binding DeviceAddress}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{l:Tr Approval.Code}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding MatchCode}" FontFamily="{StaticResource Font.Mono}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{l:Tr Approval.CodeHint}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                        <Run Text="{l:Tr Approval.ExpiresIn}" /> <Run Text="{Binding Countdown, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource Button.Secondary}" Content="{l:Tr Approval.Deny}" Command="{Binding RejectCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource Button.Primary}" c:Ui.Icon="{StaticResource Icon.Check}" Content="{l:Tr Approval.Allow}" Command="{Binding ApproveCommand}" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Overlay: incoming files (when not on the Receive page) ===== -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding OverlayRequest, Converter={StaticResource VisibleIfSet}}">
            <Border Background="{DynamicResource Brush.Scrim}" />
            <ContentControl Content="{Binding OverlayRequest}" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <pages:IncomingRequestCard />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>

        <!-- ===== Toasts ===== -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Width="380" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="success"><Setter Property="Fill" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="warning"><Setter Property="Fill" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="danger"><Setter Property="Fill" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Text.Body}" Margin="12,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Icon}" c:Ui.Icon="{StaticResource Icon.Close}" MinHeight="28" MinWidth="28" Padding="5"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{l:Tr Common.Close}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
