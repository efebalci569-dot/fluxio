<UserControl x:Class="Fluxio.Desktop.Views.Controls.QrPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fluxio.Desktop.Controls"
             xmlns:l="clr-namespace:Fluxio.Desktop.Services"
             xmlns:vm="clr-namespace:Fluxio.Desktop.ViewModels">
    <!-- DataContext: SessionViewModel -->
    <Border Style="{StaticResource Card}" Padding="22">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr Qr.Title}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Style="{StaticResource SessionPill}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- QR code (waiting for a scan) -->
            <StackPanel Visibility="{Binding ShowQr, Converter={StaticResource Visible}}">
                <Border Background="{DynamicResource Brush.QrBackground}" CornerRadius="16" Padding="14" HorizontalAlignment="Center"
                        AutomationProperties.Name="{l:Tr Qr.ImageName}">
                    <Viewbox Width="248" Height="248" Stretch="Uniform">
                        <Path Data="{Binding QrCode}" Fill="{DynamicResource Brush.QrForeground}" RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True" />
                    </Viewbox>
                </Border>
                <TextBlock Text="{l:Tr Qr.Scan}" Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,16,0,4" FontWeight="SemiBold" />
                <TextBlock Text="{l:Tr Qr.ScanHint}" Style="{StaticResource Text.Muted}" TextAlignment="Center" FontSize="13" />
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Caption}">
                            <Run Text="{l:Tr Qr.ExpiresIn}" /> <Run Text="{Binding Countdown, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                        </TextBlock>
                        <ProgressBar Value="{Binding CountdownProgress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,6,12,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" c:Ui.Icon="{StaticResource Icon.Refresh}" Content="{l:Tr Qr.NewCode}" Command="{Binding StartCommand}" />
                </Grid>
                <Border Style="{StaticResource Inset}" Margin="0,14,0,0" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Tr Qr.Address}" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding Endpoint}" FontFamily="{StaticResource Font.Mono}" FontSize="13" Foreground="{DynamicResource Brush.Text}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Icon}" c:Ui.Icon="{StaticResource Icon.Copy}" Command="{Binding CopyLinkCommand}"
                                ToolTip="{l:Tr Qr.CopyLink}" AutomationProperties.Name="{l:Tr Qr.CopyLink}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Starting -->
            <StackPanel Visibility="{Binding State, Converter={StaticResource VisibleIfEquals}, ConverterParameter=Starting}" Margin="0,40">
                <c:Icon Data="{StaticResource Icon.Qr}" Size="40" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" TextAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

            <!-- Phone paired, waiting for approval -->
            <StackPanel Visibility="{Binding IsAwaitingApproval, Converter={StaticResource Visible}}" Margin="0,8">
                <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource Brush.WarningSoft}" HorizontalAlignment="Center">
                    <c:Icon Data="{StaticResource Icon.Phone}" Size="30" Foreground="{DynamicResource Brush.Warning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,14,0,6" FontWeight="SemiBold" />
                <TextBlock Text="{l:Tr Qr.ApproveHint}" Style="{StaticResource Text.Muted}" TextAlignment="Center" FontSize="13" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource Button.Secondary}" Content="{l:Tr Approval.Deny}" Command="{Binding RejectCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Primary}" c:Ui.Icon="{StaticResource Icon.Check}" Content="{l:Tr Approval.Allow}" Command="{Binding ApproveCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Connected phone -->
            <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource Inset}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource Brush.SuccessSoft}" VerticalAlignment="Top">
                            <c:Icon Data="{StaticResource Icon.Phone}" Size="24" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{Binding DeviceLabel}" Style="{StaticResource Text.Subtitle}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                <Run Text="{Binding DeviceAddress, Mode=OneWay}" /> · <Run Text="{Binding ConnectedSince, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{l:Tr Qr.NotResponding}" Foreground="{DynamicResource Brush.Warning}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding DeviceResponsive, Converter={StaticResource Hidden}}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,12,0,0" />
                <Button Style="{StaticResource Button.Ghost}" c:Ui.Icon="{StaticResource Icon.Power}" Content="{l:Tr Qr.Disconnect}" Command="{Binding EndCommand}"
                        HorizontalAlignment="Left" Margin="-8,10,0,0" />
            </StackPanel>

            <!-- No session / expired / ended / error -->
            <StackPanel Visibility="{Binding ShowStart, Converter={StaticResource Visible}}" Margin="0,8">
                <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center">
                    <c:Icon Data="{StaticResource Icon.Qr}" Size="30" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Muted}" TextAlignment="Center" Margin="0,14,0,0" />
                <Border Style="{StaticResource Notice.Error}" Margin="0,14,0,0" Visibility="{Binding ErrorText, Converter={StaticResource VisibleIfSet}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Body}" />
                        <Expander Header="{l:Tr Common.Details}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,6,0,0" FontSize="12">
                            <TextBox Text="{Binding ErrorDetail, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="12" Margin="0,4,0,0" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource Button.Primary}" c:Ui.Icon="{StaticResource Icon.Qr}" Content="{l:Tr Qr.Create}" Command="{Binding StartCommand}"
                        HorizontalAlignment="Center" Margin="0,18,0,0" Padding="22,11" />
            </StackPanel>

            <!-- Network warning -->
            <Border Style="{StaticResource Notice.Warning}" Margin="0,16,0,0" Visibility="{Binding NetworkWarning, Converter={StaticResource VisibleIfSet}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:Icon Data="{StaticResource Icon.Alert}" Size="18" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding NetworkWarning}" Style="{StaticResource Text.Body}" FontSize="13" />
                        <Button Style="{StaticResource Button.Link}" Content="{l:Tr Qr.NetworkHelp}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                Command="{Binding DataContext.NavigateToSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>

</UserControl>
