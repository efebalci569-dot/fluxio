<Application x:Class="Fluxio.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Fluxio.Desktop.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is replaced at runtime by ThemeService (Dark/Light). -->
                <ResourceDictionary Source="/Fluxio;component/Resources/Themes/Dark.xaml" />
                <ResourceDictionary Source="/Fluxio;component/Resources/Icons.xaml" />
                <ResourceDictionary Source="/Fluxio;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <c:BoolToVisibility x:Key="Visible" />
            <c:BoolToVisibility x:Key="Hidden" Invert="True" />
            <c:NullToVisibility x:Key="VisibleIfSet" />
            <c:NullToVisibility x:Key="VisibleIfEmpty" Invert="True" />
            <c:EqualsToVisibility x:Key="VisibleIfEquals" />
            <c:EqualsToVisibility x:Key="HiddenIfEquals" Invert="True" />
            <c:EqualsToBool x:Key="EqualsToBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
