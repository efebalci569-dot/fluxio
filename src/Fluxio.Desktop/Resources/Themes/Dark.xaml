<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluxio dark theme (brand default). Same palette as the phone UI and website. -->
    <Color x:Key="Color.Background">#0B1020</Color>
    <Color x:Key="Color.Sidebar">#0E1427</Color>
    <Color x:Key="Color.Surface">#141C33</Color>
    <Color x:Key="Color.Surface2">#1A2440</Color>
    <Color x:Key="Color.SurfaceHover">#202B4B</Color>
    <Color x:Key="Color.Border">#26324F</Color>
    <Color x:Key="Color.BorderStrong">#36446B</Color>
    <Color x:Key="Color.Text">#E8EDF7</Color>
    <Color x:Key="Color.TextMuted">#A3AEC6</Color>
    <Color x:Key="Color.TextSubtle">#7783A0</Color>
    <Color x:Key="Color.Accent">#22D3EE</Color>
    <Color x:Key="Color.Accent2">#3B82F6</Color>
    <Color x:Key="Color.AccentContrast">#04121F</Color>
    <Color x:Key="Color.Receive">#A5B4FC</Color>
    <Color x:Key="Color.Success">#34D399</Color>
    <Color x:Key="Color.Danger">#F87171</Color>
    <Color x:Key="Color.Warning">#FBBF24</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextSubtle" Color="{StaticResource Color.TextSubtle}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentContrast" Color="{StaticResource Color.AccentContrast}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1F22D3EE" />
    <SolidColorBrush x:Key="Brush.Receive" Color="{StaticResource Color.Receive}" />
    <SolidColorBrush x:Key="Brush.ReceiveSoft" Color="#24818CF8" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#2134D399" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#21F87171" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#21FBBF24" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#B3050812" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#67E8F9" />
    <SolidColorBrush x:Key="Brush.QrBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.QrForeground" Color="#0B1020" />
    <LinearGradientBrush x:Key="Brush.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#22D3EE" />
        <GradientStop Offset="1" Color="#3B82F6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#5EE3F5" />
        <GradientStop Offset="1" Color="#6098F8" />
    </LinearGradientBrush>
</ResourceDictionary>
