<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluxio light theme. Accent colors are darker than in the dark theme for contrast on white. -->
    <Color x:Key="Color.Background">#F4F6FB</Color>
    <Color x:Key="Color.Sidebar">#EBEFF6</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Surface2">#EEF2F8</Color>
    <Color x:Key="Color.SurfaceHover">#E3E9F3</Color>
    <Color x:Key="Color.Border">#DBE2EE</Color>
    <Color x:Key="Color.BorderStrong">#C3CDDF</Color>
    <Color x:Key="Color.Text">#0E1526</Color>
    <Color x:Key="Color.TextMuted">#4B5772</Color>
    <Color x:Key="Color.TextSubtle">#66728C</Color>
    <Color x:Key="Color.Accent">#0369A1</Color>
    <Color x:Key="Color.Accent2">#1D4ED8</Color>
    <Color x:Key="Color.AccentContrast">#FFFFFF</Color>
    <Color x:Key="Color.Receive">#4338CA</Color>
    <Color x:Key="Color.Success">#15803D</Color>
    <Color x:Key="Color.Danger">#B91C1C</Color>
    <Color x:Key="Color.Warning">#A16207</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextSubtle" Color="{StaticResource Color.TextSubtle}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentContrast" Color="{StaticResource Color.AccentContrast}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1A0369A1" />
    <SolidColorBrush x:Key="Brush.Receive" Color="{StaticResource Color.Receive}" />
    <SolidColorBrush x:Key="Brush.ReceiveSoft" Color="#1A4338CA" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#1A15803D" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#17B91C1C" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#1CA16207" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#800E1526" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#0369A1" />
    <SolidColorBrush x:Key="Brush.QrBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.QrForeground" Color="#0B1020" />
    <LinearGradientBrush x:Key="Brush.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0369A1" />
        <GradientStop Offset="1" Color="#1D4ED8" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0A7BBB" />
        <GradientStop Offset="1" Color="#2B5CE6" />
    </LinearGradientBrush>
</ResourceDictionary>
